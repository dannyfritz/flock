{
	"name": "@dannyfritz/flock",
	"version": "0.2.0",
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		"./ecs": {
			"types": "./dist/ecs.d.ts",
			"import": "./dist/ecs.js"
		},
		"./graphics": {
			"types": "./dist/graphics.d.ts",
			"import": "./dist/graphics.js"
		},
		"./input": {
			"types": "./dist/input.d.ts",
			"import": "./dist/input.js"
		},
		"./pool": {
			"types": "./dist/pool.d.ts",
			"import": "./dist/pool.js"
		},
		"./time": {
			"types": "./dist/time.d.ts",
			"import": "./dist/time.js"
		}
	},
	"scripts": {
		"ci": "pnpm run test:unit && pnpm run test:lint && pnpm run test:format && pnpm run test:build",
		"format": "oxfmt --write",
		"prepack": "tsdown src/ecs.ts src/graphics.ts src/input.ts src/pool.ts src/time.ts --sourcemap --format esm",
		"test:format": "oxfmt --check",
		"test:lint": "oxlint",
		"test:unit": "node --experimental-strip-types --test \"**/*.test.?(m)ts\"",
		"test:build": "pnpm run prepack",
		"test": "ultra --raw ci",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"howler": "^2",
		"many-keys-map": "^3",
		"memoize": "^11",
		"pixi.js": "^8",
		"tsdown": "^0.22.14"
	},
	"devDependencies": {
		"@storybook/html": "^10",
		"@storybook/html-vite": "^10",
		"@types/howler": "^2",
		"@types/node": "^26",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"pnpm": "^11",
		"storybook": "^10",
		"type-fest": "^5",
		"typescript": "^7",
		"ultra-runner": "^3"
	},
	"engines": {
		"node": "^26"
	},
	"ultra": {
		"concurrent": [
			"ci"
		]
	}
}
